NODE_ENV=development
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# Obrigatório em produção: gere com node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# DATABASE_PATH=./data/auth.sqlite
# Ative somente atrás de UM proxy reverso confiável, se necessário.
TRUST_PROXY=false
CHURCH_TIMEZONE=America/Sao_Paulo
# Timeout por provedor de CEP; não exige chave de API.
POSTAL_TIMEOUT_MS=5000
